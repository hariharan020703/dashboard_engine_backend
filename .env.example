# Copy to .env and fill in.
#
# Only deployment-specific values and live credentials live here: where the
# database is, where the application is reached, the two signing secrets and
# the mail relay. Token lifetimes, login throttling, query concurrency and the
# bootstrap owner are in src/config/appConfig.js, because those are product
# decisions rather than per-environment ones.
#
# A missing required value is a startup crash naming the variable. That is
# deliberate: a default signing secret fails silently in production, and a
# crash is the only failure mode that gets noticed.

# ---------------------------------------------------------------------------
# PostgreSQL - one database for both the reporting tables and the app metadata
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# The schema the reporting tables live in. The RBAC tables are created in the
# connection's default schema, so give the reporting data a schema of its own
# if either set might use a name like "users".
DB_SCHEMA=public

DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=8080

# REQUIRED. The address the application is reached at. Used to build the links
# in onboarding email and as the allowed CORS origin, so it is read from
# configuration rather than from the request's Host header - which an attacker
# controls, and an activation link is the last place to trust one.
APPLICATION_URL=http://localhost:5173

# Query cache. Without REDIS_URL the cache falls back to in-memory.
REDIS_URL=
REDIS_TTL=300
CACHE_PREFIX=bi

# Dashboard metadata. Defaults to backend/config/dashboards and "default".
DASHBOARD_DIR=
DEFAULT_DASHBOARD_ID=default

# ---------------------------------------------------------------------------
# Signing secrets
# ---------------------------------------------------------------------------

# REQUIRED, and must differ from each other. These stay in the environment
# rather than in source: they are the one thing whose disclosure forges every
# session in the system, and they should differ per deployment.
#
#   JWT_ACCESS_SECRET   signs access tokens. Anyone holding it can mint a token
#                       for any account.
#   JWT_REFRESH_SECRET  keys the HMAC that refresh and activation tokens are
#                       stored under, so a database dump cannot be replayed.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Session cookie flags. COOKIE_SECURE defaults to true when APPLICATION_URL is
# https, which is almost always what you want - set it only to allow plain-http
# local development.
COOKIE_SECURE=
COOKIE_SAMESITE=strict

# REQUIRED. Encrypts the third-party warehouse credentials stored by the
# context layer (src/modules/context-layer).
#
# Unlike the two above, this one is reversible: the application has to present
# the real Domo token on every call, so it must be able to recover it. That is
# also why it is a separate variable - rotating it invalidates every stored
# connection, which must not also mean re-issuing everyone's session.
#
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CREDENTIAL_SECRET=

# Which engine runs step 4 (Understand) of the Context Layer Builder.
#   agent - the context_layer_extractor agent on the ADK API (Elze-backend, :8300).
#   demo  - this backend writes templated facts from the selected tables' real
#           schema and sample statistics. No AI call; for demos while the
#           Anthropic credit is unavailable. The frontend reads the mode from
#           GET /api/context/settings, so this is the only switch.
CONTEXT_EXTRACTION_MODE=agent

# Where MCP clients reach a PUBLISHED context: the public URL of the read-side
# MCP server (Elze-backend/mcp-context-reader, streamable HTTP, usually ending
# in /mcp). Shown in the "MCP connection" dialog on the Context layer page.
# Leave blank until it is deployed - the dialog then says it is not available.
# The reader's bearer token is never sent to the browser (it is shared across
# every company); CONTEXT_MCP_AUTH_REQUIRED only says whether one is needed.
CONTEXT_MCP_SERVER_URL=
CONTEXT_MCP_AUTH_REQUIRED=true

# Password policy and hashing cost.
MIN_PASSWORD_LENGTH=8
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# SMTP is the only transport - there is no development mode that writes
# messages to disk, so a configuration either delivers or fails loudly.
#
# SMTP_PASSWORD is an application-specific password issued by the mail
# provider, not the mailbox login. It is here rather than in source because it
# grants ongoing send access to a real mailbox: revoking an app password in the
# provider disables just this integration and nothing else.
#
# SMTP_SECURE defaults to true on port 465 (implicit TLS) and false otherwise
# (STARTTLS). SMTP_USERNAME and SMTP_PASSWORD must be set together, or both
# left blank for an unauthenticated relay.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=

# The From address. Defaults to SMTP_USERNAME, which is what most providers
# require anyway - Gmail rejects or rewrites a From that is not the
# authenticated account or one of its verified aliases.
EMAIL_FROM=

# Optional. Printed in onboarding email so a recipient has somewhere to ask.
SUPPORT_EMAIL=
