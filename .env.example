# Copy to .env and fill in. Only the DB_* values are required.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# API
PORT=8080

# Query cache. Without REDIS_URL the cache falls back to in-memory.
REDIS_URL=
REDIS_TTL=300
CACHE_PREFIX=bi

# Max simultaneous MySQL queries per dashboard request.
QUERY_CONCURRENCY=6

# Dashboard metadata. Defaults to backend/config/dashboards and "default".
DASHBOARD_DIR=
DEFAULT_DASHBOARD_ID=default
